 {
  "id": "briefing_800AA24F",
  "en": "$f21a%2Dr. Saotome%0: New equipment has arrived from Dr. Tachibana. It's the G-Arm Riser, built specially for %1\"Getter Robo Go\"%0.$/With this, %1\"Getter Robo Go\"%0 will be able to combine into %1\"Super Getter Robo Go\"%0!$/But it burns through a lot of energy, so you'll need to be careful.",
  "note": ""
 },
 {
  "id": "briefing_800AA34B",
  "en": "$f21a%2Dr. Saotome%0: The new equipment for Getter-1 and Getter Dragon is finished!$/For Getter-1, its very own weapon: the %1\"Getter Machine Gun\"%0.$/And for Getter Dragon, its very own weapon: the %1\"Getter Beam Launcher\"%0!$/With these, the fighting should get a little easier.",
  "note": ""
 },
 {
  "id": "briefing_800AA42D",
  "en": "$f99a%3Lambert%0, %3Schwartz%0, %3Linda%0, %3Bob%0, %3Sam%0 and %3Shatner%0 have left the team.$/%1Getter Robo G%0 is currently unavailable.",
  "note": ""
 },
 {
  "id": "briefing_800AA4C7",
  "en": "There are no units that can sortie.$/Use \"Assign\" to put pilots in the machines.",
  "note": "accuracy: the quoted menu item is briefing_800A9EC4 \"Assign\", not \"Transfer\""
 },
 {
  "id": "briefing_800AA51C",
