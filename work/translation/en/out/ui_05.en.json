  "en": "$f99a%1Stilva%0 has been added.$/%1Texas Mack%0 has been added.$/%1Robo Stone%0, %1Kingdom 007%0 and %1Gustaf%0 can't sortie on the next map.",
  "note": ""
 },
 {
  "id": "briefing_800AA6EB",
  "en": "$f99a%1Shin Getter Robo%0 has been added.$/%1Robo Stone%0, %1Kingdom 007%0 and %1Gustaf%0 are now available.",
  "note": ""
 },
 {
