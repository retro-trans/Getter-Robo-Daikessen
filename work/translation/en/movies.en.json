{
  "schema": 1,
  "language": "en",
  "version": "0.8.31",
  "timing": "seconds from XA audio start; video frames located by original disc sectors at 150 sectors/second",
  "movies": {
    "C01": {
      "cues": [
        {
          "id": "C01_001",
          "start": 9.0,
          "end": 12.35,
          "en": "Left behind, left in the dust,"
        },
        {
          "id": "C01_002",
          "start": 12.35,
          "end": 15.6,
          "en": "now lose every place you could turn to."
        },
        {
          "id": "C01_003",
          "start": 15.6,
          "end": 19.5,
          "en": "Rather than putting on a fake smile,"
        },
        {
          "id": "C01_004",
          "start": 19.5,
          "end": 22.8,
          "en": "sometimes it's better to be alone."
        },
        {
          "id": "C01_005",
          "start": 29.85,
          "end": 33.5,
          "en": "Things so awful they drag you down?"
        },
        {
          "id": "C01_006",
          "start": 33.5,
          "end": 37.2,
          "en": "Quit. Someone else can take your place."
        },
        {
          "id": "C01_007",
          "start": 37.2,
          "end": 40.7,
          "en": "If you throw it all away and give up,"
        },
        {
          "id": "C01_008",
          "start": 40.7,
          "end": 44.6,
          "en": "no one's going to stand in your way."
        },
        {
          "id": "C01_009",
          "start": 44.6,
          "end": 51.1,
          "en": "I don't want to leave this half done."
        },
        {
          "id": "C01_010",
          "start": 52.0,
          "end": 55.2,
          "en": "Even when you're betrayed and hurt,"
        },
        {
          "id": "C01_011",
          "start": 55.2,
          "end": 58.4,
          "en": "you can grow stronger. Change your heart."
        },
        {
          "id": "C01_012",
          "start": 58.4,
          "end": 62.25,
          "en": "I've come this far. I can't stop."
        },
        {
          "id": "C01_013",
          "start": 62.25,
          "end": 66.0,
          "en": "I can't stand losing. No way out."
        },
        {
          "id": "C01_014",
          "start": 66.0,
          "end": 69.0,
          "en": "At a crossroads, on the way back,"
        },
        {
          "id": "C01_015",
          "start": 69.0,
          "end": 72.95,
          "en": "I look back, but the night rain hides it all."
        },
        {
          "id": "C01_016",
          "start": 72.95,
          "end": 76.8,
          "en": "Something's missing. I can't stop."
        },
        {
          "id": "C01_017",
          "start": 76.8,
          "end": 80.8,
          "en": "With all this doubt, there's no way out."
        },
        {
          "id": "C01_018",
          "start": 80.8,
          "end": 85.05,
          "en": "I have to press on until the answer appears."
        },
        {
          "id": "C01_019",
          "start": 85.05,
          "end": 87.5,
          "en": "Never, never mind."
        }
      ]
    },
    "C02": {
      "cues": [
        {
          "id": "C02_001",
          "start": 4.45,
          "end": 6.9,
          "en": "It worked! The Getter Rays are flowing!"
        },
        {
          "id": "C02_002",
          "start": 14.7,
          "end": 16.05,
          "en": "Yes! That's it!"
        },
        {
          "id": "C02_003",
          "start": 16.05,
          "end": 18.7,
          "en": "Keep going! Keep going just like that!"
        },
        {
          "id": "C02_004",
          "start": 24.4,
          "end": 25.8,
          "en": "What?!"
        },
        {
          "id": "C02_005",
          "start": 27.75,
          "end": 28.65,
          "en": "What's wrong?"
        },
        {
          "id": "C02_006",
          "start": 28.65,
          "end": 31.15,
          "en": "Doctor! This is...!"
        },
        {
          "id": "C02_007",
          "start": 31.8,
          "end": 34.3,
          "en": "Were there too many Getter Rays?"
        },
        {
          "id": "C02_008",
          "start": 35.3,
          "end": 38.8,
          "en": "You mean... it shorted out?"
        },
        {
          "id": "C02_009",
          "start": 39.25,
          "end": 42.95,
          "en": "To circulate this many Getter Rays through its body,"
        },
        {
          "id": "C02_010",
          "start": 42.95,
          "end": 46.05,
          "en": "we must study every detail more closely..."
        },
        {
          "id": "C02_011",
          "start": 48.05,
          "end": 49.55,
          "en": "Shut off the Getter Rays!"
        },
        {
          "id": "C02_012",
          "start": 49.8,
          "end": 52.05,
          "en": "Wait! I want to find the cause!"
        },
        {
          "id": "C02_013",
          "start": 52.05,
          "end": 54.35,
          "en": "Reduce the energy output to one third!"
        },
        {
          "id": "C02_014",
          "start": 54.35,
          "end": 56.4,
          "en": "Check every affected section!"
        },
        {
          "id": "C02_015",
          "start": 56.4,
          "end": 57.15,
          "en": "Yes, sir!"
        },
        {
          "id": "C02_016",
          "start": 58.65,
          "end": 61.9,
          "en": "Father, you should get some rest..."
        },
        {
          "id": "C02_017",
          "start": 66.8,
          "end": 68.8,
          "en": "The stars are beautiful."
        },
        {
          "id": "C02_018",
          "start": 69.0,
          "end": 72.75,
          "en": "It was a night like this when I discovered Getter Rays."
        },
        {
          "id": "C02_019",
          "start": 73.0,
          "end": 75.6,
          "en": "Truly the discovery of the century."
        },
        {
          "id": "C02_020",
          "start": 76.1,
          "end": 79.0,
          "en": "Just a tiny amount yields tremendous energy."
        },
        {
          "id": "C02_021",
          "start": 79.0,
          "end": 80.95,
          "en": "A miraculous light..."
        },
        {
          "id": "C02_022",
          "start": 80.95,
          "end": 83.25,
          "en": "The discovery of Getter Rays"
        },
        {
          "id": "C02_023",
          "start": 83.25,
          "end": 86.3,
          "en": "opened up endless possibilities for our research."
        },
        {
          "id": "C02_024",
          "start": 86.65,
          "end": 89.2,
          "en": "But Father, even if it's for space exploration,"
        },
        {
          "id": "C02_025",
          "start": 89.2,
          "end": 92.9,
          "en": "aren't you rushing the Getter Project?"
        },
        {
          "id": "C02_026",
          "start": 94.9,
          "end": 100.95,
          "en": "Dad, shouldn't we have taken more time with this experiment, too?"
        },
        {
          "id": "C02_027",
          "start": 110.4,
          "end": 111.9,
          "en": "We must hurry..."
        },
        {
          "id": "C02_028",
          "start": 120.2,
          "end": 122.6,
          "en": "Someone get Dr. Saotome!"
        },
        {
          "id": "C02_029",
          "start": 123.4,
          "end": 124.5,
          "en": "What's happened?"
        },
        {
          "id": "C02_030",
          "start": 124.75,
          "end": 127.3,
          "en": "The Getter Ray circuits are opening one by one!"
        },
        {
          "id": "C02_031",
          "start": 127.3,
          "end": 128.5,
          "en": "Impossible!"
        },
        {
          "id": "C02_032",
          "start": 129.95,
          "end": 132.2,
          "en": "Could the Getter Rays themselves be...?"
        },
        {
          "id": "C02_033",
          "start": 132.9,
          "end": 133.9,
          "en": "Doctor!"
        }
      ]
    },
    "C03": {
      "cues": [],
      "note": "Grunts, laughter and effects only; reject ASR sign-off hallucinations."
    },
    "C04": {
      "cues": [
        {
          "id": "C04_001",
          "start": 0.0,
          "end": 3.35,
          "en": "My name is Gore!"
        },
        {
          "id": "C04_002",
          "start": 3.35,
          "end": 5.95,
          "en": "Gore, Demon King of the Underworld!"
        },
        {
          "id": "C04_003",
          "start": 6.1,
          "end": 9.3,
          "en": "We Reptilians have returned to the surface,"
        },
        {
          "id": "C04_004",
          "start": 9.3,
          "end": 13.55,
          "en": "to rule this paradise once more!"
        }
      ]
    },
    "C05": {
      "cues": [
        {
          "id": "C05_001",
          "start": 1.95,
          "end": 4.15,
          "en": "Getter Team! Are you all right?"
        },
        {
          "id": "C05_002",
          "start": 4.45,
          "end": 6.5,
          "en": "I've come to help, for what it's worth!"
        },
        {
          "id": "C05_003",
          "start": 6.5,
          "end": 7.65,
          "en": "Launch!"
        },
        {
          "id": "C05_004",
          "start": 7.85,
          "end": 10.25,
          "en": "Akane! Tsubaki! Kaede!"
        },
        {
          "id": "C05_005",
          "start": 11.1,
          "end": 12.9,
          "en": "Reinforcements from Dr. Tachibana?!"
        },
        {
          "id": "C05_006",
          "start": 13.05,
          "end": 15.0,
          "en": "Then that machine is...!"
        },
        {
          "id": "C05_007",
          "start": 16.1,
          "end": 18.8,
          "en": "The ladies of the Getter Team are here!"
        },
        {
          "id": "C05_008",
          "start": 18.8,
          "end": 21.15,
          "en": "You can stop worrying now!"
        },
        {
          "id": "C05_009",
          "start": 21.2,
          "end": 23.9,
          "en": "The name's Zan! Getter Zan!"
        },
        {
          "id": "C05_010",
          "start": 24.35,
          "end": 25.8,
          "en": "Introductions can wait!"
        },
        {
          "id": "C05_011",
          "start": 25.8,
          "end": 27.0,
          "en": "Let's go!"
        }
      ],
      "labels": [
        {
          "id": "C05_LABEL_KAEDE",
          "start_frame": 242,
          "end_frame": 314,
          "en": "Kaede",
          "rect": [
            228,
            162,
            64,
            53
          ]
        },
        {
          "id": "C05_LABEL_TSUBAKI",
          "start_frame": 336,
          "end_frame": 355,
          "en": "Tsubaki",
          "rect": [
            14,
            91,
            77,
            54
          ]
        },
        {
          "id": "C05_LABEL_AKANE",
          "start_frame": 365,
          "end_frame": 391,
          "en": "Akane",
          "rect": [
            32,
            121,
            75,
            63
          ]
        }
      ]
    },
    "C06": {
      "cues": [
        {
          "id": "C06_001",
          "start": 0.1,
          "end": 2.2,
          "en": "How could this happen?"
        },
        {
          "id": "C06_002",
          "start": 2.4,
          "end": 5.3,
          "en": "Getter Rays drove us underground."
        },
        {
          "id": "C06_003",
          "start": 5.45,
          "end": 7.9,
          "en": "Humans, evolved by Getter Rays,"
        },
        {
          "id": "C06_004",
          "start": 7.9,
          "end": 9.8,
          "en": "stole the surface from us."
        },
        {
          "id": "C06_005",
          "start": 10.45,
          "end": 14.55,
          "en": "And now Getter Robo, powered by those same rays, will kill me!"
        },
        {
          "id": "C06_006",
          "start": 15.1,
          "end": 16.15,
          "en": "Why?!"
        },
        {
          "id": "C06_007",
          "start": 16.6,
          "end": 20.9,
          "en": "Why did the Getter Rays choose humanity and turn against us?!"
        },
        {
          "id": "C06_008",
          "start": 21.4,
          "end": 25.4,
          "en": "Is our ambition, our wish to reclaim the surface,"
        },
        {
          "id": "C06_009",
          "start": 25.4,
          "end": 29.4,
          "en": "something we have no right to desire?!"
        },
        {
          "id": "C06_010",
          "start": 29.9,
          "end": 33.55,
          "en": "Go on! Kill me! Do it!"
        },
        {
          "id": "C06_011",
          "start": 34.2,
          "end": 37.65,
          "en": "Then allow me to oblige."
        },
        {
          "id": "C06_012",
          "start": 44.65,
          "end": 46.8,
          "en": "Wh-Who are you?!"
        },
        {
          "id": "C06_013",
          "start": 51.05,
          "end": 52.9,
          "en": "A pleasure to meet you."
        },
        {
          "id": "C06_014",
          "start": 53.0,
          "end": 55.3,
          "en": "My name is Burai."
        },
        {
          "id": "C06_015",
          "start": 55.3,
          "end": 58.7,
          "en": "Emperor Burai of the Hyakki Empire."
        },
        {
          "id": "C06_016",
          "start": 58.7,
          "end": 60.5,
          "en": "The Hyakki Empire?!"
        },
        {
          "id": "C06_017",
          "start": 60.5,
          "end": 61.9,
          "en": "Emperor Burai?!"
        },
        {
          "id": "C06_018",
          "start": 61.9,
          "end": 64.3,
          "en": "They just keep coming!"
        },
        {
          "id": "C06_019",
          "start": 64.3,
          "end": 68.3,
          "en": "I was waiting for you and those reptiles to kill each other."
        },
        {
          "id": "C06_020",
          "start": 68.3,
          "end": 70.7,
          "en": "What a useless lot."
        },
        {
          "id": "C06_021",
          "start": 70.7,
          "end": 75.1,
          "en": "Still, I shall settle for being rid of those troublesome lizards."
        },
        {
          "id": "C06_022",
          "start": 75.1,
          "end": 78.0,
          "en": "We shall meet again."
        },
        {
          "id": "C06_023",
          "start": 78.0,
          "end": 82.15,
          "en": "Do try to stay alive until then."
        },
        {
          "id": "C06_024",
          "start": 85.0,
          "end": 86.75,
          "en": "The Hyakki Empire..."
        },
        {
          "id": "C06_025",
          "start": 86.75,
          "end": 89.0,
          "en": "Emperor Burai..."
        }
      ]
    },
    "C07": {
      "cues": [
        {
          "id": "C07_001",
          "start": 12.85,
          "end": 14.7,
          "en": "We've only just completed it!"
        },
        {
          "id": "C07_002",
          "start": 14.7,
          "end": 17.45,
          "en": "Getter Robo Go, launch!"
        },
        {
          "id": "C07_003",
          "start": 17.45,
          "end": 19.45,
          "en": "Let's go, Sho! Gai!"
        },
        {
          "id": "C07_004",
          "start": 19.45,
          "end": 20.95,
          "en": "You don't have to tell me!"
        },
        {
          "id": "C07_005",
          "start": 20.95,
          "end": 22.3,
          "en": "I've been waiting for this!"
        },
        {
          "id": "C07_006",
          "start": 22.7,
          "end": 25.0,
          "en": "Getter Robo, launch!"
        }
      ]
    },
    "C08": {
      "cues": [
        {
          "id": "C08_001",
          "start": 2.65,
          "end": 5.1,
          "en": "Impossible!"
        },
        {
          "id": "C08_002",
          "start": 5.1,
          "end": 7.2,
          "en": "My Uzahra!"
        },
        {
          "id": "C08_003",
          "start": 7.2,
          "end": 9.3,
          "en": "I, Burai...!"
        },
        {
          "id": "C08_004",
          "start": 9.3,
          "end": 12.2,
          "en": "D-Damn you, Getter Robo!"
        },
        {
          "id": "C08_005",
          "start": 12.5,
          "end": 15.3,
          "en": "Then I shall turn this very Earth into a hellscape,"
        },
        {
          "id": "C08_006",
          "start": 15.3,
          "end": 19.35,
          "en": "a land where none of you can survive!"
        }
      ]
    },
    "C09": {
      "cues": [
        {
          "id": "C09_001",
          "start": 4.95,
          "end": 7.7,
          "en": "My name is Lando."
        },
        {
          "id": "C09_002",
          "start": 7.7,
          "end": 11.05,
          "en": "I am the savior who will save the Earth."
        },
        {
          "id": "C09_003",
          "start": 11.05,
          "end": 11.9,
          "en": "What?!"
        },
        {
          "id": "C09_004",
          "start": 12.0,
          "end": 13.9,
          "en": "Lando? It can't be!"
        },
        {
          "id": "C09_005",
          "start": 13.9,
          "end": 15.15,
          "en": "You know him?"
        },
        {
          "id": "C09_006",
          "start": 15.15,
          "end": 17.6,
          "en": "He was a leading authority on Getter Rays,"
        },
        {
          "id": "C09_007",
          "start": 17.6,
          "end": 20.5,
          "en": "on a par with Father and Dr. Tachibana."
        },
        {
          "id": "C09_008",
          "start": 21.1,
          "end": 24.95,
          "en": "So that satellite Getter Beam Cannon was Lando's work, too!"
        },
        {
          "id": "C09_009",
          "start": 25.1,
          "end": 27.1,
          "en": "Precisely."
        },
        {
          "id": "C09_010",
          "start": 27.1,
          "end": 31.6,
          "en": "A demon's hand is about to transform the Earth."
        },
        {
          "id": "C09_011",
          "start": 32.05,
          "end": 33.3,
          "en": "The time has come."
        },
        {
          "id": "C09_012",
          "start": 33.3,
          "end": 35.9,
          "en": "Bow before me and obey!"
        },
        {
          "id": "C09_013",
          "start": 36.1,
          "end": 38.85,
          "en": "We shall return to our primitive state!"
        },
        {
          "id": "C09_014",
          "start": 38.85,
          "end": 40.55,
          "en": "Lando! My brother...!"
        },
        {
          "id": "C09_015",
          "start": 40.55,
          "end": 42.4,
          "en": "What have you done with Shinichi?!"
        },
        {
          "id": "C09_016",
          "start": 43.05,
          "end": 44.7,
          "en": "Your brother, Shinichi?"
        },
        {
          "id": "C09_017",
          "start": 45.4,
          "end": 47.6,
          "en": "Lando was a brilliant scientist."
        },
        {
          "id": "C09_018",
          "start": 48.25,
          "end": 50.45,
          "en": "My brother left Father's lab"
        },
        {
          "id": "C09_019",
          "start": 50.45,
          "end": 53.35,
          "en": "to work at Lando's research institute."
        },
        {
          "id": "C09_020",
          "start": 53.6,
          "end": 55.9,
          "en": "But Lando's ideas were so dangerous,"
        },
        {
          "id": "C09_021",
          "start": 55.9,
          "end": 58.55,
          "en": "he was expelled from the scientific community."
        },
        {
          "id": "C09_022",
          "start": 58.55,
          "end": 61.95,
          "en": "That's when he and my brother disappeared."
        },
        {
          "id": "C09_023",
          "start": 62.0,
          "end": 63.75,
          "en": "Dangerous ideas?"
        },
        {
          "id": "C09_024",
          "start": 64.05,
          "end": 67.65,
          "en": "Getter Rays are a super energy that drives evolution."
        },
        {
          "id": "C09_025",
          "start": 67.65,
          "end": 70.9,
          "en": "Lando wanted to force humanity to evolve with Getter Rays"
        },
        {
          "id": "C09_026",
          "start": 70.9,
          "end": 73.7,
          "en": "and create a new form of life."
        },
        {
          "id": "C09_027",
          "start": 74.75,
          "end": 77.4,
          "en": "But that is all in the past now."
        },
        {
          "id": "C09_028",
          "start": 77.9,
          "end": 80.25,
          "en": "For you in the Allied Army,"
        },
        {
          "id": "C09_029",
          "start": 80.25,
          "end": 82.55,
          "en": "I shall send a special soldier."
        },
        {
          "id": "C09_030",
          "start": 82.55,
          "end": 85.35,
          "en": "You may ask that one about Shinichi, too."
        },
        {
          "id": "C09_031",
          "start": 85.8,
          "end": 89.6,
          "en": "Do enjoy yourselves."
        },
        {
          "id": "C09_032",
          "start": 91.45,
          "end": 93.0,
          "en": "Lando!"
        }
      ]
    },
    "C10": {
      "cues": [
        {
          "id": "C10_001",
          "start": 0.0,
          "end": 5.2,
          "en": "My goal is to return humanity to its primitive state."
        },
        {
          "id": "C10_002",
          "start": 5.7,
          "end": 8.5,
          "en": "Rasetsu, to carry out my plan,"
        },
        {
          "id": "C10_003",
          "start": 8.5,
          "end": 12.3,
          "en": "dispatch our troops to nations across the world!"
        },
        {
          "id": "C10_004",
          "start": 12.3,
          "end": 13.75,
          "en": "Yes, Lord Lando!"
        },
        {
          "id": "C10_005",
          "start": 14.65,
          "end": 16.1,
          "en": "Here are your orders!"
        },
        {
          "id": "C10_006",
          "start": 16.1,
          "end": 18.65,
          "en": "General Bat, to Germany!"
        },
        {
          "id": "C10_007",
          "start": 18.9,
          "end": 19.85,
          "en": "Yes, sir!"
        },
        {
          "id": "C10_008",
          "start": 20.1,
          "end": 21.95,
          "en": "Gore, to Russia!"
        },
        {
          "id": "C10_009",
          "start": 22.25,
          "end": 23.5,
          "en": "As you command!"
        },
        {
          "id": "C10_010",
          "start": 24.0,
          "end": 27.05,
          "en": "Burai, you will go to Britain."
        },
        {
          "id": "C10_011",
          "start": 29.0,
          "end": 31.05,
          "en": "Can you no longer hear me?"
        },
        {
          "id": "C10_012",
          "start": 31.05,
          "end": 33.85,
          "en": "This is what comes of resisting the brainwashing."
        },
        {
          "id": "C10_013",
          "start": 33.85,
          "end": 35.15,
          "en": "No matter."
        },
        {
          "id": "C10_014",
          "start": 35.15,
          "end": 37.65,
          "en": "All forces, move out!"
        }
      ]
    },
    "C11": {
      "cues": [
        {
          "id": "C11_001",
          "start": 5.45,
          "end": 9.85,
          "en": "The Texas is entering its final battle."
        },
        {
          "id": "C11_002",
          "start": 10.8,
          "end": 13.6,
          "en": "Prepare to fire the Dover Cannon!"
        },
        {
          "id": "C11_003",
          "start": 13.6,
          "end": 14.2,
          "en": "What?!"
        },
        {
          "id": "C11_004",
          "start": 14.2,
          "end": 16.05,
          "en": "Get out of there, Captain!"
        },
        {
          "id": "C11_005",
          "start": 16.6,
          "end": 18.15,
          "en": "Hurry up!"
        },
        {
          "id": "C11_006",
          "start": 18.45,
          "end": 21.45,
          "en": "I'm counting on you all."
        },
        {
          "id": "C11_007",
          "start": 23.55,
          "end": 25.35,
          "en": "The enemy ship is charging us!"
        },
        {
          "id": "C11_008",
          "start": 25.35,
          "end": 26.65,
          "en": "Destroy it!"
        },
        {
          "id": "C11_009",
          "start": 26.65,
          "end": 28.8,
          "en": "Keep it away from the Dragon Turtle!"
        },
        {
          "id": "C11_010",
          "start": 31.6,
          "end": 32.5,
          "en": "It's no use!"
        },
        {
          "id": "C11_011",
          "start": 32.5,
          "end": 33.8,
          "en": "We're going to collide!"
        },
        {
          "id": "C11_012",
          "start": 36.0,
          "end": 37.5,
          "en": "Captain!"
        },
        {
          "id": "C11_013",
          "start": 38.0,
          "end": 40.65,
          "en": "Dover Cannon... fire!"
        }
      ]
    },
    "C12": {
      "cues": [
        {
          "id": "C12_001",
          "start": 10.7,
          "end": 13.2,
          "en": "Everyone, you did a fine job!"
        },
        {
          "id": "C12_002",
          "start": 14.05,
          "end": 16.2,
          "en": "All units, return to base!"
        }
      ]
    },
    "C13": {
      "cues": [],
      "note": "Music/effects only; no translatable text."
    },
    "C14": {
      "cues": [
        {
          "id": "C14_001",
          "start": 23.25,
          "end": 27.5,
          "en": "Shin Getter Dragon!"
        }
      ]
    },
    "C15": {
      "cues": [
        {
          "id": "C15_001",
          "start": 8.1,
          "end": 9.9,
          "en": "That's the spirit!"
        },
        {
          "id": "C15_002",
          "start": 9.9,
          "end": 12.3,
          "en": "You Japanese have to be greedy and stubborn!"
        },
        {
          "id": "C15_003",
          "start": 12.4,
          "end": 14.65,
          "en": "We've come to help you, too."
        },
        {
          "id": "C15_004",
          "start": 14.65,
          "end": 16.3,
          "en": "You'd better be grateful!"
        },
        {
          "id": "C15_005",
          "start": 16.3,
          "end": 17.6,
          "en": "You heard her!"
        },
        {
          "id": "C15_006",
          "start": 17.6,
          "end": 20.35,
          "en": "We can't let the Japanese get all the glory!"
        },
        {
          "id": "C15_007",
          "start": 20.35,
          "end": 24.05,
          "en": "We've come this far. Let us see this through with you!"
        },
        {
          "id": "C15_008",
          "start": 25.15,
          "end": 27.0,
          "en": "That can't be all you've got."
        },
        {
          "id": "C15_009",
          "start": 27.0,
          "end": 28.4,
          "en": "Show us!"
        },
        {
          "id": "C15_010",
          "start": 28.4,
          "end": 30.5,
          "en": "Show us Getter Robo's power!"
        }
      ]
    },
    "C16": {
      "cues": [
        {
          "id": "C16_001",
          "start": 8.25,
          "end": 11.35,
          "en": "Say good-bye, loneliness."
        },
        {
          "id": "C16_002",
          "start": 11.35,
          "end": 18.2,
          "en": "The rest of the dream I'd almost forgotten..."
        },
        {
          "id": "C16_003",
          "start": 18.2,
          "end": 20.1,
          "en": "Once again."
        },
        {
          "id": "C16_004",
          "start": 29.95,
          "end": 32.65,
          "en": "The wind at dawn was sad."
        },
        {
          "id": "C16_005",
          "start": 32.65,
          "end": 35.3,
          "en": "I felt as though I'd fall apart."
        },
        {
          "id": "C16_006",
          "start": 35.3,
          "end": 37.8,
          "en": "Where is love?"
        },
        {
          "id": "C16_007",
          "start": 37.8,
          "end": 39.4,
          "en": "I need love."
        },
        {
          "id": "C16_008",
          "start": 40.3,
          "end": 43.5,
          "en": "I want someone to understand me,"
        },
        {
          "id": "C16_009",
          "start": 43.5,
          "end": 47.8,
          "en": "but no one does. I'm torn."
        },
        {
          "id": "C16_010",
          "start": 47.8,
          "end": 51.5,
          "en": "Always..."
        },
        {
          "id": "C16_011",
          "start": 51.5,
          "end": 57.35,
          "en": "I always kept my pain hidden,"
        },
        {
          "id": "C16_012",
          "start": 57.35,
          "end": 60.3,
          "en": "in my soul."
        },
        {
          "id": "C16_013",
          "start": 61.15,
          "end": 63.75,
          "en": "Say good-bye, loneliness."
        },
        {
          "id": "C16_014",
          "start": 63.75,
          "end": 66.5,
          "en": "I'm glad I met you"
        },
        {
          "id": "C16_015",
          "start": 66.5,
          "end": 70.6,
          "en": "in this rusted city."
        },
        {
          "id": "C16_016",
          "start": 70.6,
          "end": 74.1,
          "en": "Time to say good-bye, loneliness."
        },
        {
          "id": "C16_017",
          "start": 74.1,
          "end": 78.35,
          "en": "Let's make just a tiny opening,"
        },
        {
          "id": "C16_018",
          "start": 78.35,
          "end": 82.55,
          "en": "and open our hearts."
        },
        {
          "id": "C16_019",
          "start": 102.5,
          "end": 105.1,
          "en": "I was afraid someone would scold me,"
        },
        {
          "id": "C16_020",
          "start": 105.1,
          "end": 108.1,
          "en": "so I just kept holding back my tears."
        },
        {
          "id": "C16_021",
          "start": 108.1,
          "end": 110.4,
          "en": "Where is love?"
        },
        {
          "id": "C16_022",
          "start": 110.4,
          "end": 112.25,
          "en": "I need love."
        },
        {
          "id": "C16_023",
          "start": 112.25,
          "end": 116.1,
          "en": "You gave me something special."
        },
        {
          "id": "C16_024",
          "start": 116.1,
          "end": 119.4,
          "en": "My false self and my past"
        },
        {
          "id": "C16_025",
          "start": 119.4,
          "end": 122.4,
          "en": "all fade away."
        },
        {
          "id": "C16_026",
          "start": 122.8,
          "end": 126.2,
          "en": "Always... I was searching"
        },
        {
          "id": "C16_027",
          "start": 126.2,
          "end": 131.3,
          "en": "for the strength never to lose,"
        },
        {
          "id": "C16_028",
          "start": 131.3,
          "end": 133.55,
          "en": "in my soul."
        },
        {
          "id": "C16_029",
          "start": 133.55,
          "end": 136.55,
          "en": "Say good-bye, loneliness."
        },
        {
          "id": "C16_030",
          "start": 136.55,
          "end": 140.0,
          "en": "Let's see the rest of the dream"
        },
        {
          "id": "C16_031",
          "start": 140.0,
          "end": 144.0,
          "en": "I'd almost forgotten."
        },
        {
          "id": "C16_032",
          "start": 144.0,
          "end": 147.3,
          "en": "Time to say good-bye, loneliness."
        },
        {
          "id": "C16_033",
          "start": 147.3,
          "end": 151.7,
          "en": "I won't let life carry me along,"
        },
        {
          "id": "C16_034",
          "start": 151.7,
          "end": 156.1,
          "en": "as long as I'm with you."
        }
      ],
      "credits_file": "movie_credits.en.json"
    },
